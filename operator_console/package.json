{
  "name": "@cwl/operator-console",
  "version": "0.27.0",
  "private": true,
  "type": "module",
  "description": "Operator presentment Storybook for invoice-draft, collection-case, payment-intent, payment-receipt, credit-adjustment, rate-card, usage-event, rating-run, and tax-assessment statement contracts.",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./tokens": "./tokens/design_tokens.json",
    "./tokens.css": "./tokens/design_tokens.css"
  },
  "files": [
    "src",
    "tokens",
    "fixtures"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build --output-dir storybook-static",
    "test": "node --test tests/render_fixtures.test.js",
    "lint": "node scripts/lint_console.mjs"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/html": "8.6.14",
    "@storybook/html-vite": "8.6.14",
    "storybook": "8.6.14",
    "vite": "6.3.5"
  }
}
