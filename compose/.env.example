# Compose deployment defaults for the metering billing platform.
#
# Copy this file to compose/.env before running:
#   cp compose/.env.example compose/.env
# docker compose reads that file when invoked with
#   docker compose -f compose/docker-compose.yml ...
#
# Every value below is a development-only default.  For production you must
# change at least POSTGRES_PASSWORD and METERING_BILLING_POSTGRES_DSN to a
# secret-managed value, and point the DSN host away from the in-project
# database if you run PostgreSQL outside this project.

# --- PostgreSQL (in-project database) ---
# Database name created on first boot.
POSTGRES_DB=metering_billing
# Database superuser name.  Change for production.
POSTGRES_USER=metering_billing
# Development-only password.  Change for production and keep it out of git.
POSTGRES_PASSWORD=metering_billing_dev_only_change_me
# Host port where PostgreSQL is reachable from your machine.
POSTGRES_HOST_PORT=5433

# --- Billing API ---
# Host port where the HTTP accept surface is reachable from your machine.
BILLING_API_HOST_PORT=8000
# Port the API listens on inside its container; keep in sync with
# BILLING_API_HOST_PORT unless you intentionally split them.
BILLING_API_PORT=8000

# --- Ledger backend ---
# The API always runs with the durable PostgreSQL system of record here.
# Override only when you move PostgreSQL outside this project: keep the same
# value for both services by editing this one variable.
# Default inside the project network:
METERING_BILLING_POSTGRES_DSN=postgresql://metering_billing:metering_billing_dev_only_change_me@postgres_database:5432/metering_billing

# --- Accounting Information System ---
# Optional base URL of the AIS posting-receipt service.  Leave empty when AIS
# is not part of your environment yet.
AIS_BASE_URL=

# --- OpenTelemetry ---
# Tracing is opt-in.  When enabled, set an OTLP/HTTP collector endpoint; no
# request bodies, tenant pins, API keys, or secret headers become span data.
METERING_BILLING_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=metering-billing-platform
