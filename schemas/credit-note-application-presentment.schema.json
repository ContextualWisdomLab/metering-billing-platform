{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.contextualwisdomlab.org/metering-billing/credit-note-application-presentment/v1",
  "title": "Credit Note Application Presentment",
  "description": "Tenant-scoped commercial statement projected from a stored credit_note_application and the current collection_case. Amounts are exact-decimal strings. Application status stays applied. Next operator action is collect or wait. The document is not a statutory credit note, tax unwind, payment capture, or AIS posting.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credit_note_application_presentment_contract_version",
    "credit_note_application_id",
    "tenant_reference",
    "issued_credit_note_id",
    "collection_case_id",
    "invoice_draft_id",
    "currency_code",
    "applied_amount",
    "remaining_outstanding_amount",
    "credit_note_application_status",
    "collection_case_status",
    "applied_at",
    "source_payload_hash",
    "issued_credit_note_source_payload_hash",
    "issued_credit_note_contract_version",
    "next_operator_action"
  ],
  "properties": {
    "credit_note_application_presentment_contract_version": {
      "type": "integer",
      "minimum": 1
    },
    "credit_note_application_id": {"type": "string", "format": "uuid"},
    "tenant_reference": {"type": "string", "pattern": "^urn:cwl:"},
    "issued_credit_note_id": {"type": "string", "format": "uuid"},
    "collection_case_id": {"type": "string", "format": "uuid"},
    "invoice_draft_id": {"type": "string", "format": "uuid"},
    "issued_invoice_id": {"type": "string", "format": "uuid"},
    "currency_code": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "applied_amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 39
    },
    "remaining_outstanding_amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 39
    },
    "credit_note_application_status": {"type": "string", "enum": ["applied"]},
    "collection_case_status": {
      "type": "string",
      "enum": ["open", "dunning", "settled"]
    },
    "applied_at": {"type": "string", "format": "date-time"},
    "source_payload_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "issued_credit_note_source_payload_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "issued_credit_note_contract_version": {"type": "integer", "minimum": 1},
    "next_operator_action": {
      "type": "string",
      "enum": ["collect", "wait"]
    }
  }
}
