{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.contextualwisdomlab.org/metering-billing/release-evidence-manifest/v1",
  "title": "Release Evidence Source Manifest",
  "description": "Exact-head tracked-file hashes for controlled release reproducibility; not an SBOM, provenance statement, or signature.",
  "type": "object",
  "additionalProperties": false,
  "required": ["release_evidence_contract_version", "release_version", "source_commit", "artifacts"],
  "properties": {
    "release_evidence_contract_version": {"type": "integer", "const": 1},
    "release_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "pattern": "^[^/].*"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
