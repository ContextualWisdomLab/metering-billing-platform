{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.contextualwisdomlab.org/metering-billing/issued-credit-note-void/v1",
  "title": "Issued Credit Note Void",
  "description": "Append-only commercial void of one unused same-tenant issued_credit_note. One void exists per (tenant_account_id, issued_credit_note_id). Replays acknowledge the stored issued_credit_note_void_id. Collection remaining is unchanged because the note was never applied. The document is not a journal, webhook event, VAT register, NTS filing, statutory credit note, or AIS posting.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issued_credit_note_void_contract_version",
    "issued_credit_note_void_outcome_code"
  ],
  "properties": {
    "issued_credit_note_void_contract_version": {"type": "integer", "minimum": 1},
    "issued_credit_note_void_outcome_code": {
      "type": "string",
      "enum": ["accepted", "duplicate_replay", "rejected"]
    },
    "issued_credit_note_void_id": {"type": "string", "format": "uuid"},
    "tenant_reference": {"type": "string", "pattern": "^urn:cwl:"},
    "issued_credit_note_id": {"type": "string", "format": "uuid"},
    "credit_adjustment_id": {"type": "string", "format": "uuid"},
    "invoice_draft_id": {"type": "string", "format": "uuid"},
    "issued_invoice_id": {"type": "string", "format": "uuid"},
    "currency_code": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "voided_amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 39
    },
    "issued_credit_note_void_status": {"type": "string", "enum": ["recorded"]},
    "voided_at": {"type": "string", "format": "date-time"},
    "source_payload_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "next_operator_action": {"type": "string", "minLength": 1},
    "rejection_reason_code": {
      "type": "string",
      "enum": [
        "tenant_not_found",
        "issued_credit_note_not_found",
        "credit_note_already_applied",
        "currency_mismatch",
        "request_invalid"
      ]
    }
  }
}
