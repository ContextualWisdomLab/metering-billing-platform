{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.contextualwisdomlab.org/metering-billing/issued-invoice-void/v1",
  "title": "Issued Invoice Void",
  "description": "Append-only commercial void of one same-tenant issued_invoice. One void exists per (tenant_account_id, issued_invoice_id). Replays acknowledge the stored issued_invoice_void_id and never re-close a collection case. The document is not a journal, webhook event, payment receipt, credit note, write-off, refund, settlement, or AIS posting.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issued_invoice_void_contract_version",
    "issued_invoice_void_outcome_code"
  ],
  "properties": {
    "issued_invoice_void_contract_version": {"type": "integer", "minimum": 1},
    "issued_invoice_void_outcome_code": {
      "type": "string",
      "enum": ["accepted", "duplicate_replay", "rejected"]
    },
    "issued_invoice_void_id": {"type": "string", "format": "uuid"},
    "tenant_reference": {"type": "string", "pattern": "^urn:cwl:"},
    "issued_invoice_id": {"type": "string", "format": "uuid"},
    "invoice_draft_id": {"type": "string", "format": "uuid"},
    "collection_case_id": {"type": "string", "format": "uuid"},
    "currency_code": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "voided_amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 39
    },
    "remaining_outstanding_amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 39
    },
    "issued_invoice_void_status": {"type": "string", "enum": ["recorded"]},
    "collection_case_status": {
      "type": "string",
      "enum": ["open", "dunning", "settled", "voided"]
    },
    "voided_at": {"type": "string", "format": "date-time"},
    "source_payload_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "next_operator_action": {"type": "string", "minLength": 1},
    "rejection_reason_code": {
      "type": "string",
      "enum": [
        "tenant_not_found",
        "issued_invoice_not_found",
        "payment_receipt_exists",
        "credit_note_already_applied",
        "collection_write_off_exists",
        "unapplied_cash_already_applied",
        "collection_case_settled",
        "outstanding_mismatch",
        "currency_mismatch",
        "request_invalid"
      ]
    }
  }
}
