{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.contextualwisdomlab.org/metering-billing/collection-dispute/v1",
  "title": "Collection Dispute",
  "description": "Append-only commercial dispute hold of one same-tenant open or dunning collection case. remaining_outstanding_amount is a snapshot of current remaining and must not change. Case status becomes disputed. Replays acknowledge the stored collection_dispute_id and never re-hold. The document is not a payment receipt, credit note, settlement, write-off, void, journal, webhook event, or AIS posting.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "collection_dispute_contract_version",
    "collection_dispute_outcome_code"
  ],
  "properties": {
    "collection_dispute_contract_version": {"type": "integer", "minimum": 1},
    "collection_dispute_outcome_code": {
      "type": "string",
      "enum": ["accepted", "duplicate_replay", "rejected"]
    },
    "collection_dispute_id": {"type": "string", "format": "uuid"},
    "tenant_reference": {"type": "string", "pattern": "^urn:cwl:"},
    "collection_case_id": {"type": "string", "format": "uuid"},
    "invoice_draft_id": {"type": "string", "format": "uuid"},
    "issued_invoice_id": {"type": "string", "format": "uuid"},
    "currency_code": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "remaining_outstanding_amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 39
    },
    "collection_dispute_status": {"type": "string", "enum": ["held"]},
    "collection_case_status": {
      "type": "string",
      "enum": ["disputed"]
    },
    "held_at": {"type": "string", "format": "date-time"},
    "source_payload_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "next_operator_action": {"type": "string", "minLength": 1},
    "rejection_reason_code": {
      "type": "string",
      "enum": [
        "tenant_not_found",
        "collection_case_not_found",
        "collection_case_disputed",
        "collection_case_settled",
        "collection_case_voided",
        "currency_mismatch",
        "request_invalid"
      ]
    }
  }
}
