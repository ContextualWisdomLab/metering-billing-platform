{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.contextualwisdomlab.org/metering-billing/usage-event/v1",
  "title": "Canonical Usage Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_contract_version",
    "source_event_key",
    "source_payload_hash",
    "tenant_reference",
    "billing_account_reference",
    "billing_principal_reference",
    "product_code",
    "occurred_at",
    "measurements"
  ],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "source_event_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "tenant_reference": {"type": "string", "pattern": "^urn:cwl:"},
    "billing_account_reference": {"type": "string", "pattern": "^urn:cwl:"},
    "billing_principal_reference": {"type": "string", "pattern": "^urn:cwl:"},
    "credential_reference": {"type": "string", "pattern": "^urn:cwl:"},
    "cost_center_reference": {"type": "string", "pattern": "^urn:cwl:"},
    "project_reference": {"type": "string", "pattern": "^urn:cwl:"},
    "product_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
    "operation_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
    "dimensions": {
      "type": "object",
      "maxProperties": 10,
      "additionalProperties": false,
      "properties": {
        "provider_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "model_code": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
        "workflow_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "role_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "orchestration_mode_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "backend_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "document_job_reference": {"type": "string", "pattern": "^urn:cwl:"},
        "shard_reference": {"type": "string", "pattern": "^urn:cwl:"},
        "run_reference": {"type": "string", "pattern": "^urn:cwl:"},
        "artifact_reference": {"type": "string", "pattern": "^urn:cwl:"}
      }
    },
    "occurred_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "measurements": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/measurement"}},
    "event_contract_version": {"type": "integer", "minimum": 1},
    "source_payload_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meter_code", "quantity", "unit_code", "quality_code"],
      "properties": {
        "meter_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,95}$"},
        "quantity": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$", "maxLength": 39},
        "unit_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$"},
        "quality_code": {"type": "string", "enum": ["provider_reported", "locally_measured", "deterministically_derived", "estimated", "reconstructed", "corrected"]}
      }
    }
  }
}
