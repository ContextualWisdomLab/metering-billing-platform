{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.contextualwisdomlab.org/metering-billing/issued-invoice/v2",
  "title": "Issued Invoice",
  "description": "Append-only commercial invoice snapshot issued from one tenant invoice draft. Totals are exact-decimal strings. Replays acknowledge the stored issued_invoice_id. The document is not a statutory invoice, tax invoice certificate, or AIS posting and does not invent sequential legal numbering.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issued_invoice_contract_version",
    "issued_invoice_outcome_code"
  ],
  "properties": {
    "issued_invoice_contract_version": {"type": "integer", "minimum": 1},
    "issued_invoice_outcome_code": {
      "type": "string",
      "enum": ["accepted", "duplicate_replay", "rejected"]
    },
    "issued_invoice_id": {"type": "string", "format": "uuid"},
    "tenant_reference": {"type": "string", "pattern": "^urn:cwl:"},
    "invoice_draft_id": {"type": "string", "format": "uuid"},
    "rating_run_id": {"type": "string", "format": "uuid"},
    "usage_snapshot_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "currency_code": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "tax_exclusive_amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 39
    },
    "tax_amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 39
    },
    "tax_inclusive_amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 39
    },
    "issued_invoice_status": {"type": "string", "enum": ["issued"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "due_at": {"type": "string", "format": "date-time"},
    "source_payload_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "next_operator_action": {"type": "string", "minLength": 1},
    "rejection_reason_code": {
      "type": "string",
      "enum": [
        "tenant_not_found",
        "invoice_draft_not_found",
        "late_adjustment_tax_reassessment_required",
        "request_invalid"
      ]
    },
    "issued_invoice_lines": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/issued_invoice_line"}
    }
  },
  "$defs": {
    "issued_invoice_line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line_number",
        "billing_account_reference",
        "meter_code",
        "unit_code",
        "rated_quantity",
        "unit_price_amount",
        "line_total_amount",
        "line_type"
      ],
      "properties": {
        "line_number": {"type": "integer", "minimum": 1},
        "billing_account_reference": {"type": "string", "pattern": "^urn:cwl:"},
        "meter_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,95}$"},
        "unit_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$"},
        "rated_quantity": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "maxLength": 39
        },
        "unit_price_amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "maxLength": 39
        },
        "line_total_amount": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "maxLength": 40
        },
        "line_type": {"type": "string", "enum": ["usage", "late_adjustment"]},
        "late_adjustment_invoice_adjustment_id": {"type": "string", "format": "uuid"}
      },
      "allOf": [
        {
          "if": {"properties": {"line_type": {"const": "usage"}}},
          "then": {
            "properties": {
              "line_total_amount": {
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              }
            },
            "not": {"required": ["late_adjustment_invoice_adjustment_id"]}
          }
        },
        {
          "if": {"properties": {"line_type": {"const": "late_adjustment"}}},
          "then": {
            "required": ["late_adjustment_invoice_adjustment_id"],
            "properties": {"rated_quantity": {"pattern": "^1(\\.0+)?$"}},
            "not": {
              "properties": {"line_total_amount": {"pattern": "^-?0(?:\\.0+)?$"}}
            }
          }
        }
      ]
    }
  }
}
