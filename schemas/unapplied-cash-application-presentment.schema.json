{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.contextualwisdomlab.org/metering-billing/unapplied-cash-application-presentment/v1",
  "title": "Unapplied Cash Application Presentment",
  "description": "Tenant-scoped commercial statement projected from a stored unapplied_cash_application and the current collection_case. Amounts are exact-decimal strings. Application status stays applied. Next operator action is collect, settle, or wait. Remaining zero does not settle the case. The document is not a journal, webhook, write-off, settlement, credit note, or AIS posting.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unapplied_cash_application_presentment_contract_version",
    "unapplied_cash_application_id",
    "tenant_reference",
    "unapplied_cash_id",
    "collection_case_id",
    "payment_receipt_id",
    "invoice_draft_id",
    "currency_code",
    "applied_amount",
    "remaining_outstanding_amount",
    "unapplied_cash_application_status",
    "collection_case_status",
    "applied_at",
    "source_payload_hash",
    "next_operator_action"
  ],
  "properties": {
    "unapplied_cash_application_presentment_contract_version": {
      "type": "integer",
      "minimum": 1
    },
    "unapplied_cash_application_id": {"type": "string", "format": "uuid"},
    "tenant_reference": {"type": "string", "pattern": "^urn:cwl:"},
    "unapplied_cash_id": {"type": "string", "format": "uuid"},
    "collection_case_id": {"type": "string", "format": "uuid"},
    "payment_receipt_id": {"type": "string", "format": "uuid"},
    "invoice_draft_id": {"type": "string", "format": "uuid"},
    "currency_code": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "applied_amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 39
    },
    "remaining_outstanding_amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 39
    },
    "unapplied_cash_application_status": {"type": "string", "enum": ["applied"]},
    "collection_case_status": {
      "type": "string",
      "enum": ["open", "dunning", "settled"]
    },
    "applied_at": {"type": "string", "format": "date-time"},
    "source_payload_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "next_operator_action": {
      "type": "string",
      "enum": ["collect", "settle", "wait"]
    }
  }
}
