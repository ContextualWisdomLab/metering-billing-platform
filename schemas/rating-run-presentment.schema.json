{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.contextualwisdomlab.org/metering-billing/rating-run-presentment/v1",
  "title": "Rating Run Presentment",
  "description": "Tenant-scoped commercial rating-run statement projected from a stored rating_run. Amounts are exact-decimal strings. Next operator action is draft_invoice. The document is not a journal, invoice, or statutory rating record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rating_run_presentment_contract_version",
    "rating_run_id",
    "tenant_reference",
    "rate_card_code",
    "rate_card_version",
    "window_started_at",
    "window_ended_at",
    "usage_snapshot_hash",
    "currency_code",
    "rated_total_amount",
    "recorded_at",
    "next_operator_action",
    "rating_lines"
  ],
  "properties": {
    "rating_run_presentment_contract_version": {"type": "integer", "minimum": 1},
    "rating_run_id": {"type": "string", "format": "uuid"},
    "tenant_reference": {"type": "string", "pattern": "^urn:cwl:"},
    "rate_card_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
    "rate_card_version": {"type": "integer", "minimum": 1},
    "window_started_at": {"type": "string", "format": "date-time"},
    "window_ended_at": {"type": "string", "format": "date-time"},
    "usage_snapshot_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "currency_code": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "rated_total_amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 39
    },
    "recorded_at": {"type": "string", "format": "date-time"},
    "next_operator_action": {
      "type": "string",
      "enum": ["draft_invoice"]
    },
    "rating_lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line_number",
          "billing_account_reference",
          "meter_code",
          "unit_code",
          "rated_quantity",
          "unit_price_amount",
          "line_total_amount"
        ],
        "properties": {
          "line_number": {"type": "integer", "minimum": 1},
          "billing_account_reference": {"type": "string", "pattern": "^urn:cwl:"},
          "meter_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,95}$"},
          "unit_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$"},
          "rated_quantity": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "maxLength": 39
          },
          "unit_price_amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "maxLength": 39
          },
          "line_total_amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "maxLength": 39
          }
        }
      }
    }
  }
}
