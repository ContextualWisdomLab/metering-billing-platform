{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.contextualwisdomlab.org/metering-billing/late-adjustment-application/v1",
  "title": "Late Adjustment Application Result",
  "description": "Append-only acknowledgement that immutable late-adjustment evidence was consumed for downstream rating.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "late_adjustment_application_contract_version": {},
    "late_adjustment_application_outcome_code": {},
    "late_adjustment_application_id": {},
    "late_adjustment_id": {},
    "tenant_reference": {},
    "target_period_id": {},
    "adjustment_amount": {},
    "currency_code": {},
    "applied_by": {},
    "authorization_reference": {},
    "applied_at": {},
    "late_adjustment_application_status": {},
    "next_operator_action": {},
    "rejection_reason_code": {}
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "late_adjustment_application_contract_version",
        "late_adjustment_application_outcome_code",
        "late_adjustment_application_id",
        "late_adjustment_id",
        "tenant_reference",
        "target_period_id",
        "adjustment_amount",
        "currency_code",
        "applied_by",
        "authorization_reference",
        "applied_at",
        "late_adjustment_application_status",
        "next_operator_action"
      ],
      "properties": {
        "late_adjustment_application_contract_version": {"type": "integer", "minimum": 1},
        "late_adjustment_application_outcome_code": {
          "type": "string",
          "enum": ["accepted", "duplicate_replay"]
        },
        "late_adjustment_application_id": {"type": "string", "format": "uuid"},
        "late_adjustment_id": {"type": "string", "format": "uuid"},
        "tenant_reference": {"type": "string", "pattern": "^urn:cwl:"},
        "target_period_id": {"type": "string", "format": "uuid"},
        "adjustment_amount": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "maxLength": 40
        },
        "currency_code": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "applied_by": {"type": "string", "minLength": 1},
        "authorization_reference": {"type": "string", "minLength": 1},
        "applied_at": {"type": "string", "format": "date-time"},
        "late_adjustment_application_status": {"type": "string", "const": "applied"},
        "next_operator_action": {"type": "string", "const": "rate_late_adjustment"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "late_adjustment_application_contract_version",
        "late_adjustment_application_outcome_code",
        "rejection_reason_code",
        "next_operator_action"
      ],
      "properties": {
        "late_adjustment_application_contract_version": {"type": "integer", "minimum": 1},
        "late_adjustment_application_outcome_code": {"type": "string", "const": "rejected"},
        "rejection_reason_code": {
          "type": "string",
          "enum": [
            "tenant_not_found",
            "late_adjustment_not_found",
            "actor_reference_invalid",
            "authorization_reference_invalid"
          ]
        },
        "next_operator_action": {"type": "string", "const": "wait"}
      }
    }
  ]
}
