{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.contextualwisdomlab.org/metering-billing/collection-write-off-presentment/v1",
  "title": "Collection Write Off Presentment",
  "description": "Tenant-scoped commercial statement projected from a stored collection_write_off and the current collection_case. remaining_outstanding_amount is an exact-decimal zero string after a successful write-off. Write-off status stays recorded. Next operator action is settle. The document is not a payment receipt, credit note, settlement, tax unwind, journal, webhook event, or AIS posting.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "collection_write_off_presentment_contract_version",
    "collection_write_off_id",
    "tenant_reference",
    "collection_case_id",
    "invoice_draft_id",
    "currency_code",
    "write_off_amount",
    "remaining_outstanding_amount",
    "collection_write_off_status",
    "collection_case_status",
    "written_off_at",
    "source_payload_hash",
    "next_operator_action"
  ],
  "properties": {
    "collection_write_off_presentment_contract_version": {
      "type": "integer",
      "minimum": 1
    },
    "collection_write_off_id": {"type": "string", "format": "uuid"},
    "tenant_reference": {"type": "string", "pattern": "^urn:cwl:"},
    "collection_case_id": {"type": "string", "format": "uuid"},
    "invoice_draft_id": {"type": "string", "format": "uuid"},
    "issued_invoice_id": {"type": "string", "format": "uuid"},
    "currency_code": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "write_off_amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 39
    },
    "remaining_outstanding_amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 39
    },
    "collection_write_off_status": {"type": "string", "enum": ["recorded"]},
    "collection_case_status": {
      "type": "string",
      "enum": ["open", "dunning", "settled"]
    },
    "written_off_at": {"type": "string", "format": "date-time"},
    "source_payload_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "next_operator_action": {
      "type": "string",
      "enum": ["settle"]
    }
  }
}
