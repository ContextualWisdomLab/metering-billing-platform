{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.contextualwisdomlab.org/metering-billing/tenant-api-credential-presentment/v1",
  "title": "Tenant API Credential Presentment",
  "description": "Tenant-scoped credential metadata statement projected from a stored tenant_api_credential. Next operator action is wait while active, otherwise issue. The document is not an issue response, recoverable secret, verifier, or keyed HMAC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_api_credential_presentment_contract_version",
    "tenant_api_credential_id",
    "tenant_reference",
    "credential_label",
    "credential_prefix",
    "credential_status",
    "tenant_api_credential_contract_version",
    "issued_at",
    "next_operator_action"
  ],
  "properties": {
    "tenant_api_credential_presentment_contract_version": {"type": "integer", "minimum": 1},
    "tenant_api_credential_id": {"type": "string", "format": "uuid"},
    "tenant_reference": {"type": "string", "pattern": "^urn:cwl:"},
    "credential_label": {"type": "string", "pattern": "^[a-z][a-z0-9]*_[a-z0-9_]+$"},
    "credential_prefix": {"type": "string", "minLength": 8, "maxLength": 32},
    "credential_status": {"type": "string", "enum": ["active", "revoked"]},
    "tenant_api_credential_contract_version": {"type": "integer", "minimum": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "revoked_at": {"type": "string", "format": "date-time"},
    "next_operator_action": {
      "type": "string",
      "enum": ["wait", "issue"]
    }
  }
}
