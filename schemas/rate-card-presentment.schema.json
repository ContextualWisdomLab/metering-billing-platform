{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.contextualwisdomlab.org/metering-billing/rate-card-presentment/v1",
  "title": "Rate Card Presentment",
  "description": "Tenant-scoped commercial rate-card statement projected from a stored rate_card and its latest rate_card_version. Unit amounts are exact-decimal strings. Next operator action is rate_window. The document is not a journal, tax schedule, or statutory price book.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rate_card_presentment_contract_version",
    "rate_card_id",
    "tenant_reference",
    "rate_card_name",
    "currency_code",
    "rate_card_version",
    "rate_card_version_id",
    "created_at",
    "published_at",
    "next_operator_action",
    "lines"
  ],
  "properties": {
    "rate_card_presentment_contract_version": {"type": "integer", "minimum": 1},
    "rate_card_id": {"type": "string", "format": "uuid"},
    "tenant_reference": {"type": "string", "pattern": "^urn:cwl:"},
    "rate_card_name": {"type": "string", "pattern": "^[a-z][a-z0-9]*_[a-z0-9_]+$"},
    "currency_code": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "rate_card_version": {"type": "integer", "minimum": 1},
    "rate_card_version_id": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "published_at": {"type": "string", "format": "date-time"},
    "next_operator_action": {
      "type": "string",
      "enum": ["rate_window"]
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_code", "unit_amount", "currency_code"],
        "properties": {
          "metric_code": {"type": "string", "pattern": "^[a-z][a-z0-9]*_[a-z0-9_]+$"},
          "unit_amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "maxLength": 39
          },
          "currency_code": {"type": "string", "pattern": "^[A-Z]{3}$"}
        }
      }
    }
  }
}
