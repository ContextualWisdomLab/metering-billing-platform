{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.contextualwisdomlab.org/metering-billing/rating-run/v1",
  "title": "Rating Run",
  "description": "Exact invoice-intent totals for one tenant, half-open ISO 8601 window, rate-card version, and usage snapshot. Replays acknowledge the stored rating_run_id; they never rewrite money.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rating_contract_version",
    "rating_outcome_code"
  ],
  "properties": {
    "rating_contract_version": {"type": "integer", "minimum": 1},
    "rating_outcome_code": {
      "type": "string",
      "enum": ["accepted", "duplicate_replay", "rejected"]
    },
    "rating_run_id": {"type": "string", "format": "uuid"},
    "tenant_reference": {"type": "string", "pattern": "^urn:cwl:"},
    "rate_card_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
    "rate_card_version": {"type": "integer", "minimum": 1},
    "window_started_at": {"type": "string", "format": "date-time"},
    "window_ended_at": {"type": "string", "format": "date-time"},
    "usage_snapshot_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "currency_code": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "rated_total_amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 39
    },
    "rejection_reason_code": {
      "type": "string",
      "enum": [
        "tenant_not_found",
        "rate_card_not_found",
        "rate_card_not_effective",
        "meter_price_missing",
        "billing_disposition_unknown"
      ]
    },
    "rating_lines": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/rating_line"}
    }
  },
  "$defs": {
    "rating_line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line_number",
        "billing_account_reference",
        "meter_code",
        "unit_code",
        "rated_quantity",
        "unit_price_amount",
        "line_total_amount"
      ],
      "properties": {
        "line_number": {"type": "integer", "minimum": 1},
        "billing_account_reference": {"type": "string", "pattern": "^urn:cwl:"},
        "meter_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,95}$"},
        "unit_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$"},
        "rated_quantity": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "maxLength": 39
        },
        "unit_price_amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "maxLength": 39
        },
        "line_total_amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "maxLength": 39
        }
      }
    }
  }
}
