{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.contextualwisdomlab.org/metering-billing/tenant-api-credential/v1",
  "title": "Tenant API Credential",
  "description": "Issue-once HTTP API credential for one tenant. The plaintext secret appears only on issue. Persisted rows store a keyed HMAC, never the secret. Status is active or revoked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_api_credential_contract_version",
    "tenant_api_credential_outcome_code"
  ],
  "properties": {
    "tenant_api_credential_contract_version": {"type": "integer", "minimum": 1},
    "tenant_api_credential_outcome_code": {
      "type": "string",
      "enum": ["accepted", "duplicate_replay", "rejected"]
    },
    "tenant_api_credential_id": {"type": "string", "format": "uuid"},
    "tenant_reference": {"type": "string", "pattern": "^urn:cwl:"},
    "credential_label": {"type": "string", "pattern": "^[a-z][a-z0-9]*_[a-z0-9_]+$"},
    "credential_prefix": {"type": "string", "minLength": 8, "maxLength": 32},
    "api_credential_secret": {"type": "string", "minLength": 16, "maxLength": 256},
    "credential_status": {"type": "string", "enum": ["active", "revoked"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "rejection_reason_code": {
      "type": "string",
      "enum": [
        "tenant_not_found",
        "credential_label_invalid",
        "api_credential_not_found",
        "api_credential_missing",
        "api_credential_invalid"
      ]
    }
  }
}
